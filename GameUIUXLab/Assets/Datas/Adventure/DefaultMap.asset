    HealthCost: 0
    GoldGain: 0
    HealAmount: 0
    HealPercent: 10
    Card: {fileID: 0}
  - Label: "\uC9C0\uB098\uAC04\uB2E4"
    Result: "\uC544\uBB34 \uC77C \uC5C6\uC774 \uAE38\uC744 \uB5A0\uB0A9\uB2C8\uB2E4."
