  m_Name: Shrine
  m_EditorClassIdentifier: Assembly-CSharp::MapEventData
  Title: "\uC218\uC0C1\uD55C \uC81C\uB2E8"
  Description: "\uB0A1\uC740 \uC81C\uB2E8 \uC704\uC5D0 \uAE08\uBE5B \uB3D9\uC804\uC774 \uB193\uC5EC \uC788\uC2B5\uB2C8\uB2E4. \uC791\uC740 \uB300\uAC00\uB97C \uCE58\uB974\uBA74 \uAC00\uC838\uAC08 \uC218 \uC788\uC744 \uAC83 \uAC19\uC2B5\uB2C8\uB2E4."
  Choices:
  - Label: "\uD53C\uB97C \uBC14\uCE58\uACE0 \uB3D9\uC804\uC744 \uC5BB\uB294\uB2E4"
    Result: "\uC81C\uB2E8\uC740 \uB2F9\uC2E0\uC758 \uD53C\uB97C \uBC1B\uC544\uB4E4\uC774\uACE0 \uAE08\uD654\uB97C \uB0B4\uC5B4 \uC90D\uB2C8\uB2E4."
    GoldCost: 0
    HealthCost: 6
    GoldGain: 35
    HealAmount: 0
    HealPercent: 0
    Card: {fileID: 0}
  - Label: "\uC870\uC6A9\uD788 \uAE30\uB3C4\uD55C\uB2E4"
    Result: "\uC7A0\uC2DC \uB9C8\uC74C\uC744 \uAC00\uB2E4\uB4EC\uACE0 \uAE30\uB825\uC744 \uD68C\uBCF5\uD569\uB2C8\uB2E4."
